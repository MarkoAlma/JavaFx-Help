<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.input.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" minHeight="-Infinity" minWidth="-Infinity" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.2-ea" fx:controller="com.example.kigyokfx.HelloController">
   <MenuBar>
     <menus>
       <Menu mnemonicParsing="false" text="Fájl">
         <items>
           <MenuItem mnemonicParsing="false" onAction="#onMegnyitasClick" text="Megnyitás">
                  <accelerator>
                     <KeyCodeCombination alt="UP" code="O" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
                  </accelerator>
               </MenuItem>
               <MenuItem mnemonicParsing="false" onAction="#onKilepesClick" text="Kilépés" />
         </items>
       </Menu>
       <Menu mnemonicParsing="false" text="Súgó">
         <items>
           <MenuItem mnemonicParsing="false" onAction="#onNevjegyClick" text="Névjegy" />
         </items>
       </Menu>
     </menus>
   </MenuBar>
   <HBox spacing="10.0" VBox.vgrow="ALWAYS">
      <children>
         <ListView fx:id="folista" prefHeight="300.0" prefWidth="300.0" HBox.hgrow="ALWAYS" />
         <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <children>
               <HBox spacing="10.0">
                  <children>
                     <TextField fx:id="bevitel" />
                     <Button mnemonicParsing="false" onAction="#onSzuresClick" text="Szűrés" />
                  </children>
               </HBox>
               <ListView fx:id="kislista" prefHeight="250.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
            </children>
         </VBox>
      </children>
      <VBox.margin>
         <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
      </VBox.margin>
   </HBox>
</VBox>
